{
  "configuration": {
    "values": [
      {
        "alias": "regionData",
        "valueFrom": {
          "inputReference": "metadata-sapcp:NeoRegionData:1",
          "inputKey": "$(.execution.input.region)"
        }
      }
    ],
    "output": {
      "healthOverviewAfterRecovery": "$(.appHealthMsgAfterRecovery.output.message)",
      "healthOverviewBeforeRecovery": "$(.appHealthMsgBeforeRecovery.output.message)",
      "operatorChoice": "$(.getOperatorDecision.output.selection)"
    },
    "executors": [
      {
        "execute": "monitoring-sapcp:JavaAppHealthOverview:1",
        "input": {
          "clientId": "$(.execution.input.clientId)",
          "healthCheckUrl": "https://$(.execution.input.resourceName)$(.execution.input.subAccount).$(.regionData.name).hana.ondemand.com/demo/api/health",
          "resourceName": "$(.execution.input.resourceName)",
          "clientSecret": "$(.execution.input.clientSecret)",
          "region": "$(.execution.input.region)",
          "subAccount": "$(.execution.input.subAccount)"
        },
        "alias": "appHealthBeforeRecovery",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": null,
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      },
      {
        "execute": "utils-sapcp:Void:1",
        "input": {
          "message": "State: $(.appHealthBeforeRecovery.output.state) ; HeathCheck: $(.appHealthBeforeRecovery.output.healthCheckResponseCode) ; AppErrMetrics: $(.appHealthBeforeRecovery.output.metrics) ; AppProcessesHealth: $(.appHealthBeforeRecovery.output.processesMetrics)"
        },
        "alias": "appHealthMsgBeforeRecovery",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": null,
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      },
      {
        "execute": "utils-sapcp:GetUserChoice:1",
        "input": {
          "options": "{\"restart\":\"Restart App: $(.execution.input.resourceName)\", \"restartAndRecheck\":\"Restart App: $(.execution.input.resourceName) & Check Its Health Again\", \"doNothing\":\"Do Nothing\"}",
          "title": "Confirm the next steps, based on the current app health! IMPORTANT: $(.appHealthMsgBeforeRecovery.output.message)"
        },
        "alias": "getOperatorDecision",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": null,
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      },
      {
        "execute": "applm-sapcp:RestartJavaApp:1",
        "input": {
          "clientId": "$(.execution.input.clientId)",
          "resourceName": "$(.execution.input.resourceName)",
          "clientSecret": "$(.execution.input.clientSecret)",
          "region": "$(.execution.input.region)",
          "subAccount": "$(.execution.input.subAccount)"
        },
        "alias": "restartApp",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "OR",
              "cases": [
                {
                  "expression": "$(.getOperatorDecision.output.selection)",
                  "operator": "EQUALS",
                  "semantic": "OR",
                  "values": [
                    "restart",
                    "restartAndRecheck"
                  ]
                }
              ]
            }
          ]
        },
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      },
      {
        "execute": "monitoring-sapcp:JavaAppHealthOverview:1",
        "input": {
          "clientId": "$(.execution.input.clientId)",
          "healthCheckUrl": "https://$(.execution.input.resourceName)$(.execution.input.subAccount).eu2.hana.ondemand.com/demo/api/health",
          "resourceName": "$(.execution.input.resourceName)",
          "clientSecret": "$(.execution.input.clientSecret)",
          "region": "$(.execution.input.region)",
          "subAccount": "$(.execution.input.subAccount)"
        },
        "alias": "appHealthAfterRecovery",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "OR",
              "cases": [
                {
                  "expression": "$(.getOperatorDecision.output.selection)",
                  "operator": "EQUALS",
                  "semantic": "OR",
                  "values": [
                    "restartAndRecheck"
                  ]
                }
              ]
            }
          ]
        },
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      },
      {
        "execute": "utils-sapcp:Void:1",
        "input": {
          "message": "State: $(.appHealthAfterRecovery.output.state) ; HeathCheck: $(.appHealthAfterRecovery.output.healthCheckResponseCode) ; AppErrMetrics: $(.appHealthAfterRecovery.output.metrics) ; AppProcessesHealth: $(.appHealthAfterRecovery.output.processesMetrics)"
        },
        "alias": "appHealthMsgAfterRecovery",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "OR",
              "cases": [
                {
                  "expression": "$(.getOperatorDecision.output.selection)",
                  "operator": "EQUALS",
                  "semantic": "OR",
                  "values": [
                    "restartAndRecheck"
                  ]
                }
              ]
            }
          ]
        },
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      }
    ],
    "listeners": []
  },
