        "initialDelay": null,
        "pause": null,
        "when": null,
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      },
      {
        "execute": "utils-sapcp:GetUserChoice:1",
        "input": {
          "options": "{\"restart\":\"Restart Db System : $(.execution.input.resourceName)\", \"restartAndRecheck\":\"Restart Db System : $(.execution.input.resourceName) & Check Its Health Again\", \"doNothing\":\"Do Nothing\"}",
          "title": "Confirm the next steps, based on the current db system health! IMPORTANT: $(.healthMsgBeforeRecovery.output.message)"
        },
        "alias": "getOperatorDecision",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": null,
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      },
      {
        "execute": "dblm-sapcp:RestartDbSystem:1",
