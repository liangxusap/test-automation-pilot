          "message": "- DB Accessible: $(.healthAfterRecovery.output.dbAccessible)  - VM Accessible: $(.healthAfterRecovery.output.vmAccessible)  - HA Enabled: $(.healthAfterRecovery.output.haEnabled)  - DR Enabled: $(.healthAfterRecovery.output.drEnabled)  - Takeover Running: $(.healthAfterRecovery.output.takeoverRunning)  - Maintenance Enabled: $(.healthAfterRecovery.output.maintenanceEnabled)  - Needs VM Restart: $(.healthAfterRecovery.output.needVmRestart)  - System Locked: $(.healthAfterRecovery.output.systemLocked)  - Transactions Count: $(.healthAfterRecovery.output.transactionsCount)  - Blocked Transactions: $(.healthAfterRecovery.output.blockedTransactionsCount)  - Replication Running: $(.healthAfterRecovery.output.replicationRunning)  - Active Replication: $(.healthAfterRecovery.output.activeReplication)  - Backups Status: $(.healthAfterRecovery.output.backupsStatus)  - Volumes Usage: $(.healthAfterRecovery.output.volumesUsage)  - Critical Neo Monitoring Metrics: $(.healthAfterRecovery.output.metrics)"
        },
        "alias": "healthMsgAfterRecovery",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "OR",
              "cases": [
                {
                  "expression": "$(.getOperatorDecision.output.selection)",
                  "operator": "EQUALS",
                  "semantic": "OR",
                  "values": [
                    "restartAndRecheck"
                  ]
                }
              ]
            }
          ]
        },
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      }
    ],
