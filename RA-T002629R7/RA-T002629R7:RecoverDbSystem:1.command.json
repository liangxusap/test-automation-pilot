          "password": "$(.execution.input.password)",
          "resourceName": "$(.execution.input.resourceName)",
          "region": "$(.execution.input.region)",
          "user": "$(.execution.input.user)",
          "subAccount": "$(.execution.input.subAccount)"
        },
        "alias": "restartDbSystem",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
        "when": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "OR",
              "cases": [
                {
                  "expression": "$(.getOperatorDecision.output.selection)",
                  "operator": "EQUALS",
                  "semantic": "OR",
                  "values": [
                    "restart",
                    "restartAndRecheck"
                  ]
                }
              ]
            }
          ]
        },
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": [],
        "dryRun": null
      },
      {
        "execute": "monitoring-sapcp:DbSystemHealthOverview:1",
        "input": {
          "password": "$(.execution.input.password)",
          "clientId": "$(.execution.input.clientId)",
          "resourceName": "$(.execution.input.resourceName)",
          "clientSecret": "$(.execution.input.clientSecret)",
          "region": "$(.execution.input.region)",
          "user": "$(.execution.input.user)",
          "subAccount": "$(.execution.input.subAccount)"
        },
        "alias": "healthAfterRecovery",
        "description": null,
        "progressMessage": null,
        "initialDelay": null,
        "pause": null,
